# Neon connection string (Neon console → Connect). Use the pooled URL.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Better Auth: a random 32+ character secret (openssl rand -base64 32)
BETTER_AUTH_SECRET=""
# The public URL of the site
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Leave unset to keep public sign-up disabled
# ALLOW_SIGNUP=true
